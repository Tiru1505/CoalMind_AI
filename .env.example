# ---------- Backend (FastAPI) ----------
# SQLite by default. For PostgreSQL + pgvector use e.g.:
# DATABASE_URL=postgresql+psycopg://coalmind:coalmind@localhost:5432/coalmind
DATABASE_URL=

# Change this in any shared deployment (signs session tokens)
SECRET_KEY=coalmind-demo-secret-change-me
SESSION_TTL_SECONDS=28800
# Demo Mode: show the OTP on screen (no SMS gateway). Set to 0 in production.
DEMO_SHOW_OTP=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- AI providers ----------
# mock (default, offline, deterministic) | openai_compatible (Ollama / vLLM / TGI on-prem)
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b-instruct
LLM_API_KEY=
LLM_TIMEOUT=30

# hashing (default, offline) | sbert (requires `pip install sentence-transformers`)
EMBEDDING_BACKEND=hashing
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Frontend (Vite dev proxy) ----------
VITE_API_TARGET=http://127.0.0.1:8000
